# Paramananda Data Repository .gitignore

# Large Data Extensions (> 25 MB)
*.tsv
*.bin
*.parquet
*.h5
*.zip
*.tar.gz
*.7z
*.pdf

# Large Local Archive (Moved legacy raw outputs here)
/old_old/

# Keep Samples directory explicitly tracked
!/samples/
!/samples/**
!/scripts/
!/scripts/**
!/datasets/
!/datasets/**
!/docs/
!/docs/**

# Temporary and Python artifacts
__pycache__/
*.pyc
.DS_Store
